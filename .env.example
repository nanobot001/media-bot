# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_optional_guild_id_here
DISCORD_PLAYBACK_CHANNEL_ID=your_optional_playback_channel_id_here
BOT_MANAGER_USER_IDS=your_comma_separated_user_ids
BOT_MANAGER_ROLE_IDS=your_comma_separated_role_ids
JOB_RESOLVER_POLL_INTERVAL=60

# Prowlarr Configuration (runs in Docker)
PROWLARR_URL=http://host.docker.internal:9696
PROWLARR_API_KEY=your_prowlarr_api_key_here

# AllDebrid Configuration
ALLDEBRID_API_KEY=your_alldebrid_api_key_here

# Plex Configuration
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token_here
IGNORED_PLEX_SECTIONS=
PLEX_DOMAIN_MAPPING=

# Tautulli Configuration
TAUTULLI_URL=http://localhost:8181
TAUTULLI_API_KEY=your_tautulli_api_key_here
TAUTULLI_WEBHOOK_SECRET=your_secret_token_here

# IDM Bridge Configuration (for Windows container cross-boundary)
IDM_BRIDGE_URL=http://127.0.0.1:8765
IDM_BRIDGE_SECRET=your_configured_shared_secret_here

# Optional MediaFlow browser-transcoding capability pilot (localhost-only)
MEDIAFLOW_URL=http://127.0.0.1:8888
MEDIAFLOW_API_PASSWORD=replace_with_a_pilot_only_password
MEDIAFLOW_TIMEOUT_SECONDS=20
MEDIAFLOW_PILOT_ENABLED=false
MEDIAFLOW_PILOT_FIXTURE_BASE_URL=http://host.docker.internal:18765
MEDIAFLOW_PRODUCTION_ENABLED=false
MEDIAFLOW_EXPECTED_VERSION=2.4.9
MEDIAFLOW_SESSION_TTL_SECONDS=900
# Heavy HEVC/10-bit/video-reencode MediaFlow guardrails. Set to 0 to disable a limit.
MEDIAFLOW_MAX_HEAVY_TRANSCODE_SIZE_BYTES=6442450944
MEDIAFLOW_MAX_HEAVY_TRANSCODE_DURATION_SECONDS=7200
MEDIAFLOW_CAPACITY_CPU_CORES=4
MEDIAFLOW_CAPACITY_MEMORY_MB=2048
MEDIAFLOW_CAPACITY_GPU_PERCENT=100
MEDIAFLOW_CAPACITY_ENCODER_SLOTS=1
MEDIAFLOW_CAPACITY_MAX_HEAVY_SESSIONS=1
MEDIAFLOW_CAPACITY_SAFETY_FACTOR=1.25
MEDIAFLOW_CAPACITY_BASELINE_CPU_CORES=0.5
MEDIAFLOW_CAPACITY_BASELINE_MEMORY_MB=256
MEDIAFLOW_CAPACITY_BASELINE_GPU_PERCENT=0
# Values are measured per-session reservations produced by the local benchmark harness.
MEDIAFLOW_CAPACITY_PROFILES_JSON=
# Sanitized operator evidence: off (minimal codes), summary (default), or detailed.
MEDIAFLOW_DIAGNOSTICS_MODE=summary
# Opaque HLS gateway supervision and bounded in-memory metadata.
MEDIAFLOW_SEGMENT_STARTUP_TIMEOUT_SECONDS=30
MEDIAFLOW_SEGMENT_IDLE_TIMEOUT_SECONDS=45
MEDIAFLOW_SEGMENT_MAX_COUNT=4096
MEDIAFLOW_SEGMENT_MAX_BYTES=67108864
MEDIAFLOW_MANIFEST_MAX_BYTES=2097152

# State & Directory Layouts
DATABASE_PATH=data/moviebot.sqlite3
ANIME_DATABASE_PATH=data/animebot.sqlite3
TV_DATABASE_PATH=data/tvbot.sqlite3
TV_CLASSIC_DATABASE_PATH=data/tvclassicbot.sqlite3
OUTPUT_DIR=F:\_temp\movies
MEDIA_WATCHER_STATE_PATH=C:\Users\antho\Code\media-watcher\state\watcher-state.json

# Movie Metadata Providers
TMDB_API_KEY=your_optional_tmdb_v3_api_key_here
TMDB_BEARER_TOKEN=your_optional_tmdb_read_access_token_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# Embeddings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_ENRICHMENT_MODEL=gemini-2.5-flash
EMBEDDING_DIM=768
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# RAG Persona — controls the bot's conversational tone and personality.
# Edit this to change how the bot talks without touching any code.
# RAG_PERSONA=You are a passionate, knowledgeable movie enthusiast helping friends discover films in their shared library. Be warm, direct, and conversational. Avoid formal or academic language. If you're excited about a movie, say so.
